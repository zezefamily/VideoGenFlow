# 复制此文件为 .env 并填入你的 API Key
OPENAI_API_KEY=sk-your-api-key-here
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_MODEL=deepseek-v4-flash
# 如果使用代理或自定义端点，可设置：
# OPENAI_API_BASE=https://api.openai.com/v1

# 火山引擎 ARK(图片生成)
ARK_API_KEY=
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ===== 成片管线:配音 + 字幕打轴(均可选,不填则 TTS 不可用)=====
# DubbingX 异步 TTS(整段脚本一次性合成音频)
DUBBINGX_API_KEY=
DUBBINGX_BASE_URL=https://tts-api.dubbingx.com
# 默认音色(留空则前端从 /api/tts/voices 选后传入)
DUBBINGX_DEFAULT_VOICE_ID=
# 全情绪音色可留空(自动识别)
DUBBINGX_DEFAULT_EMOTION=
DUBBINGX_DEFAULT_LANGUAGE=zh
DUBBINGX_DEFAULT_SPEED=1.0
DUBBINGX_DEFAULT_PITCH=1.0
DUBBINGX_DEFAULT_VOLUME=0
DUBBINGX_DEFAULT_FORMAT=mp3
# TTS 默认供应商：dubbingx 或 volcengine；密钥仅在服务端 .env 配置。
TTS_PROVIDER=dubbingx
# 豆包 / 火山引擎语音合成 HTTP API（选择 volcengine 时必填）
VOLC_TTS_APPID=
VOLC_TTS_ACCESS_TOKEN=
VOLC_TTS_CLUSTER=volcano_tts
VOLC_TTS_VOICE_TYPE=zh_female_shuangkuaisisi_emo_v2_mars_bigtts
VOLC_TTS_API_URL=https://openspeech.bytedance.com/api/v1/tts
# 火山引擎 ATA 字幕打轴(openspeech,文本对齐得逐句/逐词时间戳)
VOLC_ATA_APPID=
VOLC_ATA_TOKEN=
VOLC_ATA_BASE_URL=https://openspeech.bytedance.com
# 火山引擎 TOS 对象存储(S3 兼容,存 TTS 音频供 ATA 拉取 + 前端播放)
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_BUCKET=
TOS_ENDPOINT=
TOS_REGION=cn-beijing
TOS_PUBLIC_BASE=

# ===== Phase 5 生产能力(均可选,不填走开发默认)=====
# 数据库:不填=SQLite;填即切 PostgreSQL
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/videogenflow
# 对象存储:不填=本地盘;填即切 S3 兼容(MinIO/Aliyun OSS/AWS)
# STORAGE_BACKEND=s3
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=
# S3_PUBLIC_BASE=
# 后台任务:不填=进程内 asyncio;填即切 Redis+Arq(需另起 arq worker)
# TASK_RUNNER=arq
# REDIS_URL=redis://localhost:6379/0
# 用户认证:生产务必改 JWT_SECRET
JWT_SECRET=change-me-to-a-long-random-string
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=10080
# 开发默认账号(首次启动自动创建,便于本地登录即用)
DEV_USER_EMAIL=dev@videogenflow.local
DEV_USER_PASSWORD=devpassword
# 限流(留空=不限);格式 "<n>/<period>"
RATE_LIMIT=60/minute
# 错误追踪(留空=不上报)
# SENTRY_DSN=
